# /etc/watchpost.env: runtime settings for the watchpost systemd service.
# Written once by deploy/install.sh (root:watchpost, mode 0640) and never overwritten.
# Edit it, then: sudo systemctl restart watchpost
#
# This template holds no secrets. Put passwords only in /etc/watchpost.env on the VM.

# Storage (the unit's StateDirectory).
SIEM_DB=/var/lib/watchpost/watchpost.db
SIEM_PORT=8080
# SIEM_HOST is always 127.0.0.1 (forced in watchpost.service); the proxy serves HTTPS.

# HTTPS is terminated by Caddy or nginx on this machine.
SIEM_SECURE_COOKIES=1
# Take the client IP for rate limiting from the proxy's X-Forwarded-For entry.
SIEM_TRUST_PROXY=1

# Initial accounts, min. 12 characters. admin/analyst are used only when the database is
# empty; if unset, passwords are generated into /var/lib/watchpost/initial_credentials.txt.
# The read-only viewer is created on the next start whenever this is set and no `viewer`
# user exists. It is the account to publish in a demo post.
#SIEM_ADMIN_PASSWORD=
#SIEM_ANALYST_PASSWORD=
#SIEM_VIEWER_PASSWORD=

# Per-IP rate limits (token buckets). Login: burst, then N per minute. Everything else likewise.
SIEM_RATE_LIMIT=1
SIEM_LOGIN_RATE_BURST=10
SIEM_LOGIN_RATE_PER_MIN=10
SIEM_RATE_BURST=300
SIEM_RATE_PER_MIN=1200

SIEM_SESSION_TTL=28800

# Replay the synthetic attack storyline every N minutes for an unattended public demo (0 = off).
#SIEM_DEMO_LOOP=15
#SIEM_DEMO_LOOP_SPEED=1

# Optional syslog listener (unauthenticated; keep it on loopback unless you add SIEM_SYSLOG_ALLOW).
SIEM_SYSLOG=0
#SIEM_SYSLOG_BIND=127.0.0.1
#SIEM_SYSLOG_PORT=5514
